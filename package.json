{
  "name": "ai-driven-fullstack-webapp-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node scripts/run-compiled-tests.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:verify:local": "wrangler d1 execute DB --local --command \"SELECT name FROM sqlite_master WHERE type='table' AND name IN ('example_resources','users','external_identities','application_sessions','resource_scopes','scope_memberships') ORDER BY name\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.3",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
