{
  "name": "ai-driven-fullstack-webapp-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run validate:local",
    "test:unit": "tsc -p tsconfig.test.json && node scripts/run-compiled-tests.mjs",
    "validate:local": "npm run test:unit && npm run recovery:validate && npm run performance:validate && npm run performance:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:verify:local": "wrangler d1 execute DB --local --command \"SELECT name FROM sqlite_master WHERE type='table' AND name IN ('example_resources','example_resource_changes','example_resource_scope_bindings','users','external_identities','application_sessions','resource_scopes','scope_memberships') ORDER BY name\"",
    "db:recovery:validate-config": "node scripts/validate-d1-recovery-config.mjs",
    "db:recovery:preview": "bash scripts/d1-recovery-rehearsal.sh",
    "recovery:validate": "bash -n scripts/d1-recovery-rehearsal.sh && node scripts/validate-recovery-safety.mjs",
    "performance:validate": "node scripts/validate-performance-safety.mjs",
    "performance:local": "node scripts/d1-performance-benchmark.mjs --mode=local --profile=smoke",
    "db:performance:validate-config": "node scripts/d1-performance-benchmark.mjs --mode=preview --validate-config-only",
    "db:performance:preview": "node scripts/d1-performance-benchmark.mjs --mode=preview",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.3",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
