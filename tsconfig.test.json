{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": [
    "src/shared/**/*.ts",
    "src/domain/**/*.ts",
    "src/infrastructure/**/*.ts",
    "src/worker/*.ts",
    "src/worker/auth/**/*.ts",
    "src/worker/authorization/**/*.ts",
    "src/worker/audit/**/*.ts",
    "src/worker/workflow/**/*.ts",
    "src/worker/master-data/**/*.ts",
    "src/worker/business-activity/**/*.ts",
    "src/worker/transactional-notification/**/*.ts",
    "tests/**/*.ts"
  ]
}
