{
  "version": 1,
  "requiredEnvironment": "production",
  "requiredConfirmation": "DEPLOY PRODUCTION",
  "targetShaPattern": "^[a-f0-9]{40}$",
  "workflowPath": ".github/workflows/production-deploy.yml",
  "requiredSecretNames": [
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "PRODUCTION_WRANGLER_CONFIG_JSON",
    "PRODUCTION_SECURITY_SNAPSHOT_JSON"
  ],
  "forbiddenTriggers": ["pull_request", "push", "schedule"],
  "requiredValidationCommands": [
    "npm run supply-chain:lockfile",
    "npm run build",
    "npm run security:validate"
  ]
}
