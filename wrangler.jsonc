{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-driven-fullstack-webapp-template",
  "compatibility_date": "2026-09-23",
  "main": "src/worker.ts",
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_PRODUCTION_D1_NAME",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "f1ce1268-2be2-4a20-ab10-a94c32feee64"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ai-driven-webapp-template-preview",
        "database_id": "f1ce1268-2be2-4a20-ab10-a94c32feee64"
      }
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
