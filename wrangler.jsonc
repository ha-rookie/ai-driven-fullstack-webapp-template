{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-driven-fullstack-webapp-template",
  "compatibility_date": "2026-09-23",
  "main": "src/worker.ts",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
